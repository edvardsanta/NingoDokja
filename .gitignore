# Ignore os binários compilados
/bin/
/build/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Ignore diretórios específicos do sistema operacional
.DS_Store
Thumbs.db

# Ignore dependências baixadas pelo Go Modules
/pkg/mod/
/pkg/sumdb/

# Ignore arquivos gerados pelo Go
*.out
*.test
*.log

# Ignore pastas específicas de IDEs e editores
.idea/
.vscode/
*.swp

# Ignore arquivos de configuração específicos do usuário
.env
.env.production

# Ignore crawlers
**/*_scraper.go
**/scraper/**/abstract_factory.go

# Ignore  ython ambientes virtuais
.venv
__pycache__/
*.py[cod]

# torch
libtorch

# songs
song

# scraper
scraper.yaml
/vendor/
/.env.prod

# Node / pnpm
node_modules/
.pnpm-store/

# Local runtime artifacts
*.db
*.sqlite
*.sqlite3
