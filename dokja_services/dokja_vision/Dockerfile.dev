FROM docker.io/golang:1.25-bookworm

# ffmpeg samples video bytes into frames for /describe.
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/dokja_services/dokja_vision

EXPOSE 8082

CMD ["/usr/local/go/bin/go", "run", "./cmd/dokja-vision"]
