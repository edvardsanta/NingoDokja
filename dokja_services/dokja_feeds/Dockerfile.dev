FROM docker.io/golang:1.25-bookworm

# python3 and pypdf run the knowledge-extractors reading plugin (plugins.example).
RUN apt-get update && apt-get install -y \
    libzmq3-dev \
    pkg-config \
    python3 \
    python3-pypdf \
    python3-venv \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*


# Core web reading uses a fixed curl_cffi helper for TLS-fingerprint refusals.
# It performs HTTP only; no browser, JavaScript interpreter or challenge solver.
COPY dokja_services/dokja_feeds/web-requirements.txt /tmp/web-requirements.txt
RUN python3 -m venv /opt/feeds-web \
    && /opt/feeds-web/bin/pip install --no-cache-dir -r /tmp/web-requirements.txt

# Optional dependencies are installed at image build time, never by a plugin request.
ARG FEEDS_PLUGIN_EXTRAS=none
# content: every compatibility adapter (documents and media). media: only the media-perception adapter,
# without the document processor's torch and transformers, several gigabytes lighter.
COPY dokja_services/dokja_feeds/content-plugin-requirements.txt /tmp/content-plugin-requirements.txt
COPY dokja_services/dokja_feeds/media-plugin-requirements.txt /tmp/media-plugin-requirements.txt
RUN case "$FEEDS_PLUGIN_EXTRAS" in \
      none) ;; \
      content|media) python3 -m venv --system-site-packages /opt/feeds-plugins \
        && /opt/feeds-plugins/bin/pip install --no-cache-dir -r "/tmp/$FEEDS_PLUGIN_EXTRAS-plugin-requirements.txt" \
        && /opt/feeds-plugins/bin/pip uninstall -y opencv-python opencv-python-headless \
        && /opt/feeds-plugins/bin/pip install --no-cache-dir --no-deps opencv-python-headless==5.0.0.93 ;; \
      *) exit 2 ;; \
    esac
# The owner's own plugins (in feeds_plugins/, outside git) bring their libraries in a requirements
# file of the owner's, named by a path inside the build context. The default lists nothing.
ARG FEEDS_PLUGIN_REQUIREMENTS=dokja_services/dokja_feeds/no-plugin-requirements.txt
COPY ${FEEDS_PLUGIN_REQUIREMENTS} /tmp/owner-plugin-requirements.txt
RUN if grep -q '^[^#[:space:]]' /tmp/owner-plugin-requirements.txt; then \
      { [ -d /opt/feeds-plugins ] || python3 -m venv --system-site-packages /opt/feeds-plugins; } \
      && /opt/feeds-plugins/bin/pip install --no-cache-dir -r /tmp/owner-plugin-requirements.txt; \
    fi
# A browser for the owner's plugins that must run a page's scripts, such as a quiz runner.
# Off by default: Chromium and its libraries add several hundred megabytes.
ARG FEEDS_PLUGIN_BROWSER=none
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/feeds-browsers
RUN case "$FEEDS_PLUGIN_BROWSER" in \
      none) ;; \
      chromium) { [ -d /opt/feeds-plugins ] || python3 -m venv --system-site-packages /opt/feeds-plugins; } \
        && /opt/feeds-plugins/bin/pip install --no-cache-dir playwright==1.49.1 \
        && /opt/feeds-plugins/bin/playwright install --with-deps chromium \
        && rm -rf /var/lib/apt/lists/* ;; \
      *) exit 2 ;; \
    esac
ENV PATH="/opt/feeds-plugins/bin:${PATH}"

# Keep the Go module cache in the image, outside the source bind mount. Dev/lite
# startup compiles local sources but must not need a fresh dependency download.
WORKDIR /opt/feeds-build-deps
COPY dokja_services/dokja_feeds/go.mod dokja_services/dokja_feeds/go.sum ./
RUN go mod download && go mod verify

WORKDIR /workspace/dokja_services/dokja_feeds
