FROM python:3.13-slim

WORKDIR /workspace

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*

COPY dokja_services/dokja_voice/requirements.txt /tmp/dokja_voice_requirements.txt

RUN pip install --no-cache-dir -r /tmp/dokja_voice_requirements.txt
RUN pip install --no-cache-dir fastapi uvicorn
