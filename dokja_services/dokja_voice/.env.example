# Existing local recognition path; use real cached speech models for live tests.
DOKJA_VOICE_STT_PROVIDER=transformers
DOKJA_VOICE_STT_MODEL=openai/whisper-base
DOKJA_VOICE_ACOUSTIC_CLASSIFIER=transformers
DOKJA_VOICE_ACOUSTIC_MODEL=MIT/ast-finetuned-audioset-10-10-0.4593
# Set only when explicitly using the optional local GPU inference provider.
DOKJA_VOICE_CPP_ENDPOINT=
DOKJA_VOICE_CPP_MODEL_FILE=
DOKJA_VOICE_RENDER_DEVICE=/dev/dri/renderD128
